{
  "expo": {
    "name": "Shelf",
    "slug": "reader-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "folio",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF6EF",
    "android": {
      "package": "com.mraigeneralist.folio",
      "adaptiveIcon": {
        "backgroundColor": "#FFC91E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFC91E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Archivo",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Archivo_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Archivo_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Archivo_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Archivo_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Archivo_800ExtraBold.ttf",
                    "weight": 800
                  },
                  {
                    "path": "./assets/fonts/Archivo_900Black.ttf",
                    "weight": 900
                  }
                ]
              },
              {
                "fontFamily": "JetBrains Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/JetBrainsMono_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/JetBrainsMono_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-asset",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "b902c32d-15b4-4031-b9dd-597cdc005462"
      }
    }
  }
}
